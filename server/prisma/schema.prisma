// JUASS Tablets Share — data model
// NOTE: The actual admission-data Excel template was not supplied to the
// assistant that generated this schema (only a photo of a device's S/N and
// IMEI barcode label was). Core admission fields commonly used by Ghanaian
// SHS registers are modelled explicitly below, and `Student.extraFields`
// (raw JSON) captures any additional columns found in the real template at
// import time via the column-mapping screen, so no data is lost even if the
// real template has different/extra fields. Adjust the explicit fields to
// match the real template once available.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  DISTRIBUTOR
  SUPERVISOR
}

enum AssignmentStatus {
  WITH_STUDENT
  REPLACED
  RETURNED
}

enum ReplacementReason {
  FAULTY
  MISSING
  OTHER
}

enum ReturnReason {
  COMPLETED
  WITHDRAWN
  OTHER
}

enum IssueType {
  FAULTY
  MISSING
}

enum IssueStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  contact                String?
  role                   Role
  passwordHash           String
  active                 Boolean   @default(true)
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  passwordResetRequested Boolean   @default(false)
  // Identifies this account's one currently-valid login session. Logging in
  // again (any device/browser) overwrites this, which immediately
  // invalidates the previous session's cookie on its next request.
  activeSessionId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  assignments      DeviceAssignment[] @relation("DistributedBy")
  reportedIssues   DeviceIssueReport[] @relation("ReportedBy")
  reviewedIssues   DeviceIssueReport[] @relation("ReviewedBy")
  sentMessages     ChatMessage[]       @relation("SentBy")
  receivedMessages ChatMessage[]       @relation("ReceivedBy")
}

model Student {
  id             String   @id @default(cuid())
  indexNumber    String   @unique
  fullName       String
  gender         String?
  dateOfBirth    DateTime?
  className      String?
  programme      String?
  house          String?
  guardianName   String?
  guardianContact String?
  admissionYear  String?
  extraFields    Json?    // any additional imported admission-data columns
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments DeviceAssignment[]
}

model DeviceAssignment {
  id                String            @id @default(cuid())
  student           Student           @relation(fields: [studentId], references: [id])
  studentId         String
  distributor       User              @relation("DistributedBy", fields: [distributorId], references: [id])
  distributorId     String
  imei              String
  serialNumber      String
  embossmentNumber  String?
  dateAssigned      DateTime          @default(now())
  replacementDate   DateTime?
  returnedDate      DateTime?
  status            AssignmentStatus  @default(WITH_STUDENT)
  // Set on THIS record when it's the one being closed out — e.g. the old
  // device in a replace, or the device being marked returned. Kept on the
  // row they describe (not the new replacement device) so a student's
  // history reads as "this device left because X", per record.
  replacementReason ReplacementReason?
  replacementNote   String?
  returnReason      ReturnReason?
  returnNote        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  issueReports DeviceIssueReport[]

  @@index([studentId])
  @@index([distributorId])
  @@unique([imei])
  @@unique([serialNumber])
}

model DeviceIssueReport {
  id           String      @id @default(cuid())
  type         IssueType
  assignment   DeviceAssignment? @relation(fields: [assignmentId], references: [id])
  assignmentId String?
  description  String
  photoUrl     String?
  status       IssueStatus @default(PENDING)
  reportedBy   User        @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedById String
  reviewedBy   User?       @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ChatMessage {
  id          String    @id @default(cuid())
  sender      User      @relation("SentBy", fields: [senderId], references: [id])
  senderId    String
  recipient   User      @relation("ReceivedBy", fields: [recipientId], references: [id])
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A user-defined field beyond the built-in Student columns — e.g. "Scholarship
// Type" or a Year Group that only applies to one import batch. `key` is the
// slug used inside Student.extraFields (and in report/import field pickers);
// `label` is what's shown on screen and as the export column header by default.
model CustomField {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
