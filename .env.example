# Copy this file to server/.env and fill in real values.

# PostgreSQL connection string.
# Local network / on-premise (via docker-compose in this repo):
#   postgresql://juass:juass@localhost:5432/juass_tablets
# Free cloud hosting option (Neon.tech free tier, or Supabase free tier):
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://juass:juass@localhost:5432/juass_tablets"

# Long random string used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the client URL).
CORS_ORIGIN="http://localhost:5173"

# Folder (relative to server/) where uploaded photos are stored.
UPLOAD_DIR="uploads"

# Name of the school shown in the UI / exports.
SCHOOL_NAME="Juaben Senior High School"

# Optional: control the first Super Admin account the server creates the
# very first time it starts against an empty database. If left unset, the
# email defaults to admin@juass.local and the password is auto-generated
# and printed to the server logs on first boot.
# SEED_ADMIN_EMAIL="admin@juass.local"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
