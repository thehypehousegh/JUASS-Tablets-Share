# Copy this file to server/.env and fill in real values.

# PostgreSQL connection string.
# Local network / on-premise (via docker-compose in this repo):
#   postgresql://juass:juass@localhost:5432/juass_tablets
# Free cloud hosting option (Neon.tech free tier, or Supabase free tier):
#   postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://juass:juass@localhost:5432/juass_tablets"

# Long random string used to sign login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API server listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (the client URL).
CORS_ORIGIN="http://localhost:5173"

# Folder (relative to server/) where uploaded photos are stored when cloud
# storage (below) isn't configured. Fine for a local-network deployment;
# on a host without persistent disk (e.g. Render's free tier) these files
# are lost on redeploy unless S3_* below is set.
UPLOAD_DIR="uploads"

# Optional: store faulty-report photos in S3-compatible cloud storage
# instead of local disk, so they persist across redeploys and are reachable
# from anywhere. Works with Cloudflare R2, Backblaze B2, Supabase Storage,
# AWS S3, or anything else that speaks the S3 API — leave all of these
# unset to keep using local disk.
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="juass-tablets-photos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL_BASE="https://pub-xxxxxxxx.r2.dev"

# --- Automatic sync from a local-network instance to a cloud instance ---
# Set these on a LOCAL-NETWORK deployment only (e.g. the laptop running
# docker-compose at a distribution event). Every SYNC_INTERVAL_MINUTES it
# pushes a full backup to the cloud instance's /api/backup/sync, so the
# school's data never rests only on that one machine for long — even while
# working entirely offline, it catches up automatically the moment internet
# is available again. Leave unset on the cloud instance itself; it just
# needs SYNC_SECRET set (below) so it knows which pushes to accept.
# REMOTE_SYNC_URL="https://juass-tablets-share.onrender.com"
# SYNC_INTERVAL_MINUTES=5

# Shared secret authorizing automatic sync pushes — set the SAME value on
# both the local instance (as the sender) and the cloud instance (as the
# receiver). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SYNC_SECRET="change-me-to-a-long-random-string"

# Name of the school shown in the UI / exports.
SCHOOL_NAME="Juaben Senior High School"

# Optional: control the first Super Admin account the server creates the
# very first time it starts against an empty database. If left unset, the
# email defaults to admin@juass.local and the password is auto-generated
# and printed to the server logs on first boot.
# SEED_ADMIN_EMAIL="admin@juass.local"
# SEED_ADMIN_PASSWORD="ChangeMe123!"
